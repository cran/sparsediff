# sparsediff: build the vendored SparseDiffEngine (v0.3.0) C sources plus the
# R-binding glue in this directory.  GENERATED from Makevars.in by ./configure.
#
# CRAN discipline: R dictates the C standard and the optimization/warning
# flags.  We set ONLY include paths, the engine version define, and link
# libraries here -- no -std=, no -O*, no -W*, no -DNDEBUG.  The upstream CMake
# compiles every .c under its src/ (GLOB_RECURSE); we mirror that exactly.
#
# The placeholder below is filled by ./configure: when ccache is on PATH it
# becomes "CC := <ccache> $(CC)"
# so the compiler R selected is merely launched through ccache (R still
# dictates the compiler); otherwise the line is blank.  This mirrors the
# conditional ccache detection used by the SCIP R package.
@CCACHE@

ENGINE = sparsediffengine

# -DSPARSEDIFF_USE_RBLAS routes the engine's CBLAS calls through our shim
# (cblas_shim.c, declared in cblas_compat/sparsediff_cblas.h) over R's Fortran
# BLAS, so the engine uses the same BLAS as R. LAPACK_LIBS before BLAS_LIBS
# before FLIBS, per WRE.
# -DSPARSEDIFF_R_PRINT makes tracked_alloc.h pull in utils/r_io.h, which routes
# the engine's printf/fprintf(stderr)/exit through R (Rprintf/REprintf/Rf_error)
# so the libc printf/stderr/exit symbols never appear in the package .so (needed
# for R CMD check "checking compiled code").  R's own include path (for
# R_ext/Print.h / R_ext/Error.h) is supplied automatically when R compiles the
# package, so no extra -I is required here.
PKG_CPPFLAGS = -I$(ENGINE)/include -Icblas_compat -DSPARSEDIFF_USE_RBLAS -DSPARSEDIFF_R_PRINT -DDIFF_ENGINE_VERSION='"0.3.0"'
PKG_LIBS = $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS) -lm

# Engine library sources (depths 1-3 under $(ENGINE)/src cover src/, src/utils,
# src/old-code, and src/atoms/<category>/), plus this package's glue (src/*.c).
ENGINE_OBJECTS = \
  $(patsubst %.c,%.o,$(wildcard $(ENGINE)/src/*.c)) \
  $(patsubst %.c,%.o,$(wildcard $(ENGINE)/src/*/*.c)) \
  $(patsubst %.c,%.o,$(wildcard $(ENGINE)/src/*/*/*.c))

# Package glue: C sources (cblas_shim.c) + C++ sources (sparsediff.cpp and the
# cpp11-generated cpp11.cpp). The presence of .cpp objects makes R link with the
# C++ linker, which is what cpp11 needs; the engine .c stay C and interoperate
# via extern "C".
PKG_OBJECTS = $(patsubst %.c,%.o,$(wildcard *.c)) \
              $(patsubst %.cpp,%.o,$(wildcard *.cpp))

OBJECTS = $(PKG_OBJECTS) $(ENGINE_OBJECTS)
